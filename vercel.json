{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site-production",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/courts", "destination": "/index.html" },
    { "source": "/book", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/sign-in", "destination": "/admin/sign-in/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
